# Vault directory (where skills and records are stored)
VAULT_DIR=~/Documents/InlineFlow

# Host API Key (for Raycast Extension authentication)
HOST_API_KEY=your-secret-key-here

# Port for the Bun HTTP server
PORT=8787

# ── LLM Provider API Keys ────────────────────────────────────

# OpenAI (for skills using provider: openai)
OPENAI_API_KEY=your-openai-key-here

# Anthropic (for skills using provider: anthropic)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Google Gemini (for skills using provider: google)
GOOGLE_API_KEY=AIza...

# Azure OpenAI (for skills using provider: azure-openai)
# Requires both endpoint and API key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=...

# Cohere (for skills using provider: cohere)
COHERE_API_KEY=...

# OpenRouter (for skills using provider: openrouter)
# Provides unified access to multiple models
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
