# Vault directory (where skills and records are stored)
VAULT_DIR=~/Documents/InlineFlow

# Host API Key (for Raycast Extension authentication)
HOST_API_KEY=your-secret-key-here

# Port for the Bun HTTP server
PORT=8787

# LLM API Keys
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
